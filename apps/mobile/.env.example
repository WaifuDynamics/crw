# The API is always addressed with its version: .../v1. Production (eas.json) targets
# https://api.crw-plus.com/v1 and https://app.crw-plus.com once that domain is live;
# until then it stays on the konekocode addresses.
EXPO_PUBLIC_API_URL=http://localhost:4000/v1
EXPO_PUBLIC_APP_URL=http://localhost:8081
# Physical devices: use your computer's LAN IP instead of localhost.
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png
# Optional: Google sign-in client ID. Leave empty to read it from the API (GOOGLE_CLIENT_ID).
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
# Mapbox public token (pk.) for web map tiles. Without it the web maps use CARTO tiles.
EXPO_PUBLIC_MAPBOX_TOKEN=

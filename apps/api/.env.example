NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Omit DATABASE_URL only in development to use persistent embedded PostgreSQL.
DATABASE_URL=
REDIS_URL=
DATA_DIR=./data/pace
APP_URL=http://localhost:8081
API_URL=http://localhost:4000
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082
SESSION_SECRET=replace-with-at-least-32-random-characters
PAYMENT_PROVIDER=sandbox
# Enable Stripe only for countries covered by your contracted merchant entity.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_COUNTRIES=
# A contracted local provider can implement the signed hosted gateway protocol.
GATEWAY_URL=
GATEWAY_API_KEY=
GATEWAY_WEBHOOK_SECRET=
GATEWAY_COUNTRIES=LB
MAIL_PROVIDER=console
RESEND_API_KEY=
MAIL_FROM=PACE <hello@your-domain.com>
S3_BUCKET=
MEDIA_PUBLIC_URL=
S3_REGION=
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
EXPO_ACCESS_TOKEN=
# Firebase Cloud Messaging for Android pushes: a service account key (JSON or base64)
# with the "Firebase Cloud Messaging API Admin" role. Check it with scripts/check-fcm.ts.
FCM_SERVICE_ACCOUNT=
TRUST_PROXY=false
# Only read by the explicitly invoked development seed command.
SEED_PASSWORD=
# Google sign-in: OAuth 2.0 Web client ID from Google Cloud Console.
# Authorized JavaScript origins must include APP_URL (e.g. http://localhost:8081).
GOOGLE_CLIENT_ID=
# Sign in with Apple: the audiences Apple issues identity tokens for, comma separated -
# the iOS bundle identifier (app.crwplus.fitness) and the Services ID for the website.
APPLE_CLIENT_ID=
# The Services ID and return URL the browser flow needs. Leave empty to offer Apple
# sign-in in the app only.
APPLE_SERVICES_ID=
APPLE_REDIRECT_URI=
